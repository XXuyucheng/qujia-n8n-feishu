N8N_ENCRYPTION_KEY=

# 云上用公网 IP 访问时填写（本地可留空，默认 N8N_HOST=localhost）
# N8N_HOST=1.2.3.4
# N8N_PROTOCOL=http
# WEBHOOK_URL=http://1.2.3.4/
# N8N_EDITOR_BASE_URL=http://1.2.3.4/

FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_BASE_ID=
FEISHU_TABLE_ID=
FEISHU_CHAT_ID=

# 对话专用飞书应用（供应商录入机器人，与上方 n8n 主应用隔离）
FEISHU_CHAT_APP_ID=
FEISHU_CHAT_APP_SECRET=
# FEISHU_CHAT_VERIFICATION_TOKEN=
# FEISHU_CHAT_ENCRYPT_KEY=

# 对话机器人查询（只读）→ n8n Agent webhook
# N8N_QUERY_WEBHOOK_URL=http://n8n:5678/webhook/feishu-bot-query

# 镜像（compose 不能自动换源：拉失败时取消对应行注释，再 compose up / build）
# n8n 默认官方 docker.n8n.io；国内超时可改用下面任一镜像站
# N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.11.3
# N8N_IMAGE=docker.1ms.run/n8nio/n8n:2.11.3
# N8N_IMAGE=docker.m.daocloud.io/n8nio/n8n:2.11.3

# Python / nginx 已默认 docker.1ms.run；仍失败可换 DaoCloud
# PDF_PARSER_BASE_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
# FEISHU_LISTENER_BASE_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
# FEISHU_FIELD_PARSER_BASE_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
# FEISHU_FILES_GENERATION_BASE_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
# FEISHU_BOT_BASE_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
# SUPPLIER_BOT_BASE_IMAGE=docker.m.daocloud.io/library/python:3.12-slim  # 兼容旧名
# NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine

# 合同生成（路径 B / feishu-files-generation）
# FEISHU_CONTRACT_TEMPLATE_TOKEN=doxcnXXXXXXXX
# FEISHU_CONTRACT_OUTPUT_FOLDER=fldcnXXXXXXXX

# 出团计划单（复用 feishu-files-generation + Sheet 写入）
# FEISHU_DEPARTURE_TEMPLATE_TOKEN=doxcnXXXXXXXX
# FEISHU_DEPARTURE_OUTPUT_FOLDER=fldcnXXXXXXXX

# 合同盖章多模态识别（豆包 Ark Responses API）
# VISION_API_KEY=
# VISION_API_URL=https://ark.cn-beijing.volces.com/api/v3/responses
# VISION_MODEL=doubao-seed-2-0-lite-260428
